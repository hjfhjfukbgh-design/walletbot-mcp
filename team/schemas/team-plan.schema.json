{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kripto-guru.invalid/schemas/team-plan.schema.json",
  "title": "Kripto Guru Multi-Team Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_key",
          "team",
          "role",
          "title",
          "objective",
          "acceptance_criteria",
          "write_scope",
          "depends_on"
        ],
        "properties": {
          "task_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,30}$"
          },
          "team": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "role": {
            "enum": [
              "ARCHITECT",
              "BACKEND",
              "FRONTEND",
              "QA",
              "SECURITY",
              "ANALYST"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 160
          },
          "objective": {
            "type": "string",
            "minLength": 20,
            "maxLength": 3000
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 5,
              "maxLength": 500
            }
          },
          "write_scope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,30}$"
            }
          }
        }
      }
    }
  }
}
